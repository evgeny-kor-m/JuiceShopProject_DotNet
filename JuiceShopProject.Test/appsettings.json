{
  "Environment": "QA",
  "BaseUrl": "http://juice-shop.local:8080/",
  "Browser": "chrome",
  "Timeouts": {
    "ImplicitWait": 5,
    "ExplicitWait": 10
  },
  "Paths": {
    "Screenshots": "TestResults/Screenshots",
    "Logs": "TestResults/Logs"
  },
  // --- НОВЫЙ РАЗДЕЛ ДЛЯ SERILOG ---
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information", // Уровень по умолчанию для всего, что пишет Serilog
      "Override": {
        "Microsoft": "Warning" // Уменьшаем шум от библиотек Microsoft
      }
    }
  },
  // --- КОНЕЦ НОВОГО РАЗДЕЛА ---
  "LogLevels": {
    "RunLog": "Debug", // Уровень для ГЛОБАЛЬНОГО лога (общий мониторинг)
    "TestLog": "Debug"      // Уровень для ИЗОЛИРОВАННОГО лога (детальная отладка)
  }
}