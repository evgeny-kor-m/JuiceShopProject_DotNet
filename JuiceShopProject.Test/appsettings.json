{
  "Environment": "QA",
  "BaseUrl": "http://juice-shop.local:8080/",
  "Browser": "chrome",
  "Timeouts": {
    "ImplicitWait": 5,
    "ExplicitWait": 10
  },
  "Paths": {
    "Screenshots": "TestResults/Screenshots",
    "Logs": "TestResults/Logs"
  },
  // --- Serilog section ---
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information", // Default level for everything Serilog writes
      "Override": {
        "Microsoft": "Warning" // Reduce noise from Microsoft libraries
      }
    }
  },
  // --- End of Serilog section ---
  "LogLevels": {
    "RunLog": "Debug", // Level for the GLOBAL log (overall monitoring)
    "TestLog": "Debug"      // Level for the ISOLATED per-test log (detailed debugging)
  }
}